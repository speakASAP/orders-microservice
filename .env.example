# ============================================
# Orders Configuration. Single Source of Truth
# ============================================
NODE_ENV=
DOMAIN=
SERVICE_NAME=

# Auth (JWT validation - same secret as auth-microservice)
JWT_SECRET=
AUTH_SERVICE_URL=

# Upstream flipflop order-service pricing backend (temporary during migration)
FLIPFLOP_ORDER_SERVICE_URL=

# AI pricing suggestions (required by pricing generation endpoint)
AI_SERVICE_URL=http://ai-microservice:3380

# Catalog pricing write target for approved pricing suggestions
CATALOG_SERVICE_URL=http://catalog-microservice:3200
CATALOG_INTERNAL_SERVICE_TOKEN=
MARKETING_INTERNAL_SERVICE_TOKEN=

# Warehouse reservation handoff
WAREHOUSE_SERVICE_URL=http://warehouse-microservice:3201
WAREHOUSE_RESERVATION_ENABLED=false
WAREHOUSE_RESERVATION_TTL_MINUTES=15
WAREHOUSE_SERVICE_TOKEN=

JWT_TOKEN=

# Heureka order ingestion service-token bridge
HEUREKA_INTERNAL_SERVICE_TOKEN=

# Payments terminal-status bridge (payments moved to Bearer in 6u; the static
# header is no longer honoured and the ES entries were removed 2026-09-01)
PAYMENTS_ORDERS_SERVICE_TOKEN=
